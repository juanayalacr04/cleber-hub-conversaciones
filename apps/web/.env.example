# Cliente (Firebase Web). No son secretos: es la configuración pública de la app web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=
# Base de Firestore: déjala vacía para `(default)`, o el ID de la base con nombre si el proyecto comparte la default.
# La misma que FIRESTORE_DATABASE de la función y la de firebase.json.
NEXT_PUBLIC_FIRESTORE_DATABASE=

# Login (NextAuth v5 + Google). Cliente OAuth "hub-conversaciones-dev" del proyecto ambiente-desarrollo-ti
# (Arquitectura/GUIA_API_GATEWAY.md, paso 0). Solo servidor: el secreto nunca va en NEXT_PUBLIC_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Firma de la cookie de sesión: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=

# API Gateway de Cleber (solo servidor; lib/api.ts). URL del stage, sin barra final:
# https://z66x2zyooj.execute-api.us-east-1.amazonaws.com/v3
API_GATEWAY_URL=
API_GATEWAY_KEY=
# Opcional. Header del id_token que lee el authorizer; por omisión X-Id-Token (no Authorization: PostgREST lo
# rechaza con PGRST300). Debe coincidir con el Token Source del authorizer (guía, paso 6).
API_GATEWAY_TOKEN_HEADER=

# Servidor (rutas /api). Firebase Admin: una de las dos formas
FIREBASE_SERVICE_ACCOUNT_KEY=
# o FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY

# Salesforce: una sola conexión para todas las marcas; override por módulo con SF_VENTAS_* / SF_SERVICIO_*
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=

# Integraciones externas

# Proveedores
TWILIO_STATUS_CALLBACK_URL=
ABACUS_API_KEY=

# Función 2: endpoint de acciones de usuario (POST /user-actions/execute)
NEXT_PUBLIC_HUB_ACTIONS_URL=
