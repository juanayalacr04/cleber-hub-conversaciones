# Cliente (Firebase Web). No son secretos: es la configuración pública de la app web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=

# Servidor (rutas /api). Firebase Admin: una de las dos formas
FIREBASE_SERVICE_ACCOUNT_KEY=
# o FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY

# Salesforce: una sola conexión para todas las marcas; override por módulo con SF_VENTAS_* / SF_SERVICIO_*
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=

# Crons del dashboard y función de inactividad (Cloud Function de Python)
CRON_SECRET=
INACTIVITY_FUNCTION_URL=

# Integraciones externas
EXTERNAL_API_SECRET=

# Proveedores
TWILIO_STATUS_CALLBACK_URL=
ABACUS_API_KEY=

# Función 2: endpoint de acciones de usuario (POST /user-actions/execute)
NEXT_PUBLIC_HUB_ACTIONS_URL=
