# Backend (Cloud Functions). En GCP estos valores van como secretos de Secret Manager
# montados con --set-secrets; aquí solo se documentan los nombres.

# Firestore: base default (decisión 0.16)
FIRESTORE_DATABASE=(default)

# Salesforce: una sola conexión para todas las organizaciones
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=

# Endpoint de acciones: clave de cada bot (JSON {botId: clave}); el bot la manda como Bearer
BOT_ACTION_KEYS=

# Endpoint de acciones de usuarios: proyecto de Firebase (audiencia del token) y orígenes del dashboard (CORS, separados por comas)
FIREBASE_PROJECT_ID=
ALLOWED_ORIGINS=

# Invitaciones: webhook de correo (secreto), remitente y URL de la plataforma para el enlace del correo
# (si la petición viene de un origen de ALLOWED_ORIGINS, ese origen manda sobre APP_URL)
INVITE_EMAIL_WEBHOOK_URL=

# Webhook situacion-detectada (bot de Ventas -> Servicio): secreto compartido en la cabecera X-Api-Secret
# Sin él se rechaza todo; ALLOW_UNAUTHENTICATED_INTEGRATIONS=true solo para desarrollo local
SITUACION_API_SECRET=
INVITE_EMAIL_FROM=
APP_URL=

# Opcional: otro usuario de Salesforce solo para un módulo (SF_VENTAS_*, SF_SERVICIO_*)
# SF_VENTAS_USERNAME=
# SF_VENTAS_PASSWORD=

# Opcional
# ABACUS_CHATLLM_HOST=https://cleber.abacus.ai
# MAX_HISTORY_MESSAGES=10
# SESSION_TIMEOUT_HOURS=24
