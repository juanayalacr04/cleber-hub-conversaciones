# Backend (Cloud Functions). En GCP estos valores van como secretos de Secret Manager
# montados con --set-secrets; aquí solo se documentan los nombres.

# Firestore: base default (decisión 0.16)
FIRESTORE_DATABASE=(default)

# Salesforce: una sola conexión para todas las organizaciones
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=

# Opcional: otro usuario de Salesforce solo para un módulo (SF_VENTAS_*, SF_SERVICIO_*)
# SF_VENTAS_USERNAME=
# SF_VENTAS_PASSWORD=

# Opcional
# ABACUS_CHATLLM_HOST=https://cleber.abacus.ai
# MAX_HISTORY_MESSAGES=10
# SESSION_TIMEOUT_HOURS=24
